[
  {
    "i": 0,
    "utterance": "Model the effect of interest rate on monthly mortgage payment",
    "scene": {
      "intent": "fresh",
      "uid": "REHEARSED-00",
      "hero": 0,
      "slots": [
        { "t": "sim", "pos": "CENTER", "sz": "XL", "emp": 3 }
      ]
    },
    "widgets": {
      "REHEARSED-00:0": {
        "status": "ready",
        "data": {
          "t": "sim",
          "title": "Monthly mortgage payment ($)",
          "data": {
            "vars": [
              {
                "n": "p",
                "v0": 400000,
                "min": 50000,
                "max": 1000000,
                "step": 10000,
                "unit": "$"
              },
              {
                "n": "rate",
                "v0": 5,
                "min": 1,
                "max": 12,
                "step": 0.1,
                "unit": "%",
                "slider": true
              }
            ],
            "rels": [
              {
                "lhs": "monthly",
                "expr": "p * rate / 1200 / (1 - (1 + rate/1200)^(-360))"
              },
              {
                "lhs": "totalInterest",
                "expr": "monthly * 360 - p"
              }
            ],
            "chart": { "x": "rate", "y": "monthly", "scale": "lin" }
          }
        }
      }
    }
  },
