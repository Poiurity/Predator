  {
    "i": 3,
    "utterance": "Show how a request flows through cache and database in a read-heavy service",
    "scene": {
      "intent": "fresh",
      "uid": "REHEARSED-03",
      "hero": 0,
      "slots": [
        { "t": "flow", "pos": "CENTER", "sz": "XL", "emp": 3 }
      ]
    },
    "widgets": {
      "REHEARSED-03:0": {
        "status": "ready",
        "data": {
          "t": "flow",
          "title": "Read request — cache → DB path",
          "data": {
            "nodes": [
              { "id": "client",  "l": "Client",         "kind": "external" },
              { "id": "api",     "l": "API server",      "kind": "service"  },
              { "id": "cache",   "l": "Redis cache",     "kind": "cache"    },
              { "id": "db",      "l": "Postgres DB",     "kind": "storage"  },
              { "id": "resp",    "l": "Response",        "kind": "external" }
            ],
            "edges": [
              { "s": "client", "t": "api",   "l": "HTTP GET" },
              { "s": "api",    "t": "cache", "l": "lookup key" },
              { "s": "cache",  "t": "api",   "l": "HIT → data" },
              { "s": "cache",  "t": "db",    "l": "MISS → query" },
              { "s": "db",     "t": "cache", "l": "fill + TTL" },
              { "s": "api",    "t": "resp",  "l": "200 OK" }
            ]
          }
        }
      }
    }
  },
  {
    "i": 4,
    "utterance": "Model compound interest over 30 years with a monthly contribution of $500",
    "scene": {
      "intent": "fresh",
      "uid": "REHEARSED-04",
      "hero": 0,
      "slots": [
        { "t": "sim", "pos": "CENTER", "sz": "XL", "emp": 3 }
      ]
    },
    "widgets": {
      "REHEARSED-04:0": {
        "status": "ready",
        "data": {
          "t": "sim",
          "title": "Compound interest — 30-year growth ($)",
          "data": {
            "vars": [
              {
                "n": "principal",
                "v0": 10000,
                "min": 0,
                "max": 100000,
                "step": 1000,
                "unit": "$"
              },
              {
                "n": "rate",
                "v0": 7,
                "min": 1,
                "max": 20,
                "step": 0.5,
                "unit": "%",
                "slider": true
              },
              {
                "n": "monthly",
                "v0": 500,
                "min": 0,
                "max": 5000,
                "step": 50,
                "unit": "$"
              }
            ],
            "rels": [
              {
                "lhs": "futureValue",
                "expr": "principal * (1 + rate/100)^30 + monthly * 12 * ((1 + rate/100)^30 - 1) / (rate/100)"
              },
              {
                "lhs": "totalContributions",
                "expr": "principal + monthly * 360"
              },
              {
                "lhs": "gainRatio",
                "expr": "futureValue / totalContributions"
              }
            ],
            "chart": { "x": "rate", "y": "futureValue", "scale": "lin" }
          }
        }
      }
    }
  }
]
