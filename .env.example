# ============================================================================
#  Living Stage — 환경변수 템플릿
#  ─────────────────────────────────────────────────────────────────────────
#  1. 이 파일을 `.env.local` 로 복사 후 실제 값을 채워넣으세요.
#  2. `.env.local` 은 .gitignore 됨 — 절대 커밋 금지.
#  3. 프로덕션 키는 Cloudflare Worker secret으로만 등록:
#       cd worker && wrangler secret put GEMINI_API_KEY
#  4. push 전 매번:  git grep -nE 'AIza[0-9A-Za-z_-]{20,}'
# ============================================================================


# ─── Frontend (Vite — 브라우저 노출) ─────────────────────────────────────
# ⚠️  VITE_ 프리픽스 변수는 *브라우저 번들에 박힘*. 절대 키를 두지 말 것.

# Cloudflare Worker 프록시 URL (spec §3.4). 키는 Worker secret에만.
# 예: https://living-stage.<your-subdomain>.workers.dev
VITE_WORKER_URL=

# (옵션) 공개 링크 기본 텍스트 모드 (심사위원 마이크 없음 — spec §15)
VITE_TEXT_MODE_DEFAULT=true

# (옵션) HUD 표시 토글 (cachedContentTokenCount 등 — spec §10)
VITE_HUD=true


# ─── Cloudflare Worker (로컬 dev 전용) ──────────────────────────────────
# ★ 아래 값은 *.env.local 에 두지 마세요.* (VITE_ 가 아니어도 위치 혼동 위험)
# ★ Worker 디렉토리의 `.dev.vars` 파일에만 넣습니다 (gitignore 됨).
#
# worker/.dev.vars 예시:
# ────────────────────────
# GEMINI_API_KEY=AIza...
# ────────────────────────
#
# 프로덕션: `wrangler secret put GEMINI_API_KEY` (대화형 입력)
#
# ⚠️  AIza... 가 코드/커밋 어디에도 절대 들어가면 안 됨.
