# ============================================================================
#  Living Stage — 환경변수 템플릿
#  ─────────────────────────────────────────────────────────────────────────
#  1. 이 파일을 `.env.local` 로 복사 후 실제 값을 채워넣으세요.
#  2. `.env.local` 은 .gitignore 됨 — 절대 커밋 금지.
#  3. GEMINI_API_KEY 는 Cloud Run 서비스 env vars 에만 존재. 이 파일·코드·
#     커밋 어디에도 절대 안 들어감.
#  4. push 전 매번:  git grep -nE 'AIza[0-9A-Za-z_-]{20,}'
# ============================================================================


# ─── Frontend (Vite — 브라우저 노출) ─────────────────────────────────────
# ⚠️  VITE_ 프리픽스 변수는 *브라우저 번들에 박힘*. 절대 키를 두지 말 것.

# Dev proxy 타겟. Vite dev 서버가 /v1beta/* 호출을 여기로 포워딩.
# 로컬 `node server.js` (:8080) 또는 배포된 Cloud Run URL 둘 다 가능.
VITE_DEV_PROXY=http://localhost:8080
# VITE_DEV_PROXY=https://living-stage-xxxxxxx-uc.a.run.app

# (옵션) 공개 링크 기본 텍스트 모드 (심사위원 마이크 없음 — spec §15)
VITE_TEXT_MODE_DEFAULT=true

# (옵션) HUD 표시 토글 (cachedContentTokenCount 등 — spec §10)
VITE_HUD=true


# ─── Cloud Run 런타임 (서비스에 설정, 이 파일에는 안 둠) ────────────────
# 프록시 server.js 가 startup 에 process.env.GEMINI_API_KEY 읽음.
# Cloud Run 서비스에 등록하는 두 방식 — 이 파일에는 절대 값 안 둠.
#
# (A) env var 직접 (이미 사용 중):
#   gcloud run services update SERVICE \
#     --update-env-vars GEMINI_API_KEY=AIza... --region REGION
#
# (B) Secret Manager 경유 (제출용 권장 — 배포 로그에 키 안 남음):
#   echo -n "AIza..." | gcloud secrets create gemini-key --data-file=-
#   gcloud run services update SERVICE \
#     --update-secrets GEMINI_API_KEY=gemini-key:latest --region REGION
#
# 배포 명령: package.json scripts 의 `npm run start` / `npm run deploy`.
# 서비스 이름·리전 커스터마이즈: CR_SERVICE / CR_REGION 환경변수.
